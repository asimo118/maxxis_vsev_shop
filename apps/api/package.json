{
  "name": "@vsev/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts",
    "db:backup": "tsx --env-file-if-exists=../../.env src/cli/backup.ts",
    "mock:external": "tsx --env-file-if-exists=../../.env src/cli/mock-external.ts"
  },
  "dependencies": {
    "@vsev/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.58.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
