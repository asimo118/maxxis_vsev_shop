# ── API ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# "sqlite" = SQLite file (default, production). "memory" = in-process store, wiped on restart (demo / tests).
DATA_DRIVER=sqlite
# Relative paths resolve against apps/api. In production use an absolute path on a persistent disk.
SQLITE_PATH=./data/vsev.db

# Optional. Leave empty: in-process cache + durable job queue inside the SQLite file (recommended with SQLite).
REDIS_URL=

# Two independent JWT audiences — storefront tokens never work on /admin and vice versa (min 32 chars each)
JWT_SECRET_STOREFRONT=change-me-storefront-at-least-32-chars!!
JWT_SECRET_ADMIN=change-me-admin-at-least-32-chars-long!!!
BCRYPT_COST=10

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Only a console notification adapter and a mock payment gateway ship. Production refuses to boot with the mock gateway.
NOTIFY_ADAPTER=console
PAYMENT_GATEWAY=mock
# When set, POST /api/v1/payments/webhook requires an HMAC-SHA256 hex signature in x-vsev-signature
PAYMENT_WEBHOOK_SECRET=

# Ensure the first campaign, shops, templates and admin exist on boot (idempotent). Or run `pnpm db:seed` once.
SEED_ON_BOOT=false
SEED_ADMIN_EMAIL=admin@vsev.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ── Connectors (docs/connectors.md). Leave as-is to manage everything in this system. ──
# Vehicle models: local | http (synced from VEHICLE_SOURCE_URL)
VEHICLE_SOURCE=local
VEHICLE_SOURCE_URL=
VEHICLE_SOURCE_TOKEN=
# Install-shop directory: local | http (synced from SHOP_SOURCE_URL; admin shop editing becomes read-only)
SHOP_SOURCE=local
SHOP_SOURCE_URL=
SHOP_SOURCE_TOKEN=
CONNECTOR_SYNC_INTERVAL_MIN=30
CONNECTOR_TIMEOUT_MS=8000
# Cart / checkout: internal (built-in payment) | http (redirect to an external cart, results via signed webhook)
COMMERCE_CONNECTOR=internal
COMMERCE_API_URL=
COMMERCE_API_TOKEN=
COMMERCE_WEBHOOK_SECRET=
COMMERCE_RETURN_URL=http://localhost:5173/orders/{orderId}?from=checkout
COMMERCE_SKU_MAP={}

# ── Storefront (Vite, read at build time) ───────────
VITE_CAMPAIGN_SLUG=vs-ev-plus-bmw-ix2-2026q4
