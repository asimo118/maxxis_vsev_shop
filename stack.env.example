# Portainer → Stacks → maxxis-vsev → Environment variables  ("Load variables from .env file" accepts this file).
# Generate each secret with:  openssl rand -hex 32
# Never commit real values — keep them only in Portainer.

# ── Required ──
JWT_SECRET_STOREFRONT=
JWT_SECRET_ADMIN=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@vsev.local

# ── Payments: choose ONE ──
# Staging / demo — every payment auto-approves, no money moves:
ALLOW_MOCK_PAYMENTS=true
# Production with an external cart (docs/connectors.md) — set ALLOW_MOCK_PAYMENTS=false and fill in:
COMMERCE_CONNECTOR=internal
COMMERCE_API_URL=
COMMERCE_API_TOKEN=
COMMERCE_WEBHOOK_SECRET=
COMMERCE_RETURN_URL=https://shop.example.com/orders/{orderId}?from=checkout
COMMERCE_SKU_MAP={}

# ── Ports on the Docker host ──
STOREFRONT_PORT=8080
# Admin console: keep this port closed to the internet (VPN / office IP / reverse-proxy allow-list).
ADMIN_PORT=8081

# ── Reverse proxy ──
# Hops in front of the API: 1 = bundled nginx only; 2 = another proxy (Nginx Proxy Manager, Traefik, Cloudflare Tunnel…) in front.
TRUST_PROXY=1

# ── Images (published by GitHub Actions) ──
IMAGE_REGISTRY=ghcr.io/asimo118/maxxis_vsev_shop
# latest = newest build of main. Roll back by setting a previous tag, e.g. sha-8029e23697bc
IMAGE_TAG=latest

# ── Connectors (docs/connectors.md) ──
VEHICLE_SOURCE=local
VEHICLE_SOURCE_URL=
VEHICLE_SOURCE_TOKEN=
SHOP_SOURCE=local
SHOP_SOURCE_URL=
SHOP_SOURCE_TOKEN=
CONNECTOR_SYNC_INTERVAL_MIN=30

# ── Backups (written to the data volume under /data/backups) ──
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SEC=86400

LOG_LEVEL=info
