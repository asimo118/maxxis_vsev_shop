# Rendered at container start: ${API_UPSTREAM} comes from the environment (default api:4000).
# Docker's embedded DNS, re-resolved so an API restart (new container IP) never strands nginx.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade { default upgrade; "" close; }

# Cache policy by path. (Set once per server: an add_header inside a location would silently drop the
# security headers inherited from the server block.) Empty = header not added (API sets its own).
map $uri $cache_policy {
  ~^/assets/  "public, max-age=31536000, immutable";  # Vite assets are content-hashed
  ~^/api/     "";
  default     "no-cache";                             # index.html and other entry files
}

# Shared proxy settings for /api/
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header Connection $connection_upgrade;
proxy_read_timeout 30s;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json image/svg+xml text/plain;

server_tokens off;
client_max_body_size 1m;

# ───────── Storefront (public) ─────────
server {
  listen 80;
  root /usr/share/nginx/storefront;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Cache-Control $cache_policy;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  # The admin API is only reachable through the admin port (which can be firewalled / IP-restricted).
  location /api/v1/admin/ { return 404; }

  location /api/ {
    set $api_upstream http://${API_UPSTREAM};
    proxy_pass $api_upstream;
  }

  location /assets/ { try_files $uri =404; }
  location / { try_files $uri $uri/ /index.html; }
}

# ───────── Admin console (restrict this port at the firewall / reverse proxy) ─────────
server {
  listen 8081;
  root /usr/share/nginx/admin;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;
  add_header X-Robots-Tag "noindex, nofollow" always;
  add_header Cache-Control $cache_policy;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  # Only the admin API (and its login) — the customer API is not served on this port.
  location /api/v1/admin/ {
    set $api_upstream http://${API_UPSTREAM};
    proxy_pass $api_upstream;
  }
  location /api/ { return 404; }

  location /assets/ { try_files $uri =404; }
  location / { try_files $uri $uri/ /index.html; }
}
